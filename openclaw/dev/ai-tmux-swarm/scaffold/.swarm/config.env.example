# Logging verbosity: DEBUG, INFO (default), WARN, ERROR
SWARM_LOG_LEVEL=INFO

# Swarm polling
SWARM_AUTO_INSTALL_CRON=1
SWARM_POLL_INTERVAL_MINUTES=1

# Agent awareness — which OpenClaw Agent dispatched this swarm?
# When set, status changes are sent to this Agent via `openclaw agent --agent <id>`
# so it can decide next steps (merge branches, run validation, etc.)
# When empty, falls back to `openclaw system event`
SWARM_AGENT_ID=
OPENCLAW_EVENT_MODE=now

# Human-facing notifications (in addition to Agent awareness)
# SWARM_NOTIFY_MODE controls the channel for notifying humans:
#   telegram — send to Telegram
#   feishu   — send to 飞书/Lark
#   both     — send to Telegram + 飞书
#   none     — Agent only, no human notifications
SWARM_NOTIFY_MODE=none

# Telegram — used when SWARM_NOTIFY_MODE=telegram|both
TELEGRAM_CHAT_ID=
TELEGRAM_THREAD_ID=

# Feishu/Lark — used when SWARM_NOTIFY_MODE=feishu|both
# FEISHU_CHAT_ID: target format — user:openId (私聊) or oc_xxx (群组)
# FEISHU_ACCOUNT_ID: required — openclaw feishu account name (e.g. foreman)
FEISHU_CHAT_ID=
FEISHU_ACCOUNT_ID=

# Claude worker logging
# text|json|stream-json
SWARM_CLAUDE_LOG_FORMAT=stream-json
SWARM_CLAUDE_INCLUDE_PARTIAL_MESSAGES=1
SWARM_CLAUDE_VERBOSE=1
SWARM_CLAUDE_DEBUG=0
SWARM_CLAUDE_DEBUG_FILTER=
SWARM_CLAUDE_DEBUG_TO_FILE=1
